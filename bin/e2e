#!/bin/bash
# Browser checks (Playwright image, host network to reach the dev server on 127.0.0.1:8126).
#   bin/e2e demo-shot.mjs | motion.mjs | …
set -euo pipefail
PROJECT=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
if [[ $(id -u) -eq 0 ]]; then
    uid=$(id -u podman); chown -R podman: "$PROJECT/e2e"
    exec sudo -u podman -H env XDG_RUNTIME_DIR=/run/user/$uid DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$uid/bus "$PROJECT/bin/e2e" "$@"
fi
IMAGE=mcr.microsoft.com/playwright:v1.63.0-noble
run() { podman run --rm --network host --ipc host --security-opt no-new-privileges -v "$PROJECT/e2e":/e2e:Z -w /e2e \
        -e DEMO_URL -e npm_config_cache=/tmp/npm "$IMAGE" "$@"; }
[[ -d "$PROJECT/e2e/node_modules" ]] || run npm install --no-audit --no-fund >/dev/null
mkdir -p "$PROJECT/e2e/shots"
run node "${1:?script}" "${@:2}"
